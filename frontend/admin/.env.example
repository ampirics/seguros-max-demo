# Configuración de la API
# URL base del backend (puede incluir o no /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Modo mock: 1 = datos de ejemplo en el navegador, sin backend (ver mocks/README.md)
NEXT_PUBLIC_MOCK=

# URL de la tienda para "Ver tienda" (sin definir: mismo host, puerto 3001)
NEXT_PUBLIC_TIENDA_URL=http://localhost:3001

# API Key pública de la tienda
NEXT_PUBLIC_STORE_API_KEY=sk_live_your_company_public_api_key

# Alias opcional para estandarizar con otras apps
NEXT_PUBLIC_WACOMMERCE_API_KEY=sk_live_your_company_public_api_key

# Configuración de entorno
NODE_ENV=development

# Opcional: Configuración de base de datos (si se necesita desde frontend)
# DATABASE_URL=postgresql://username:CAMBIAR@localhost:5432/database_name

# Opcional: Configuración de servicios externos
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Opcional: Configuración de email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Opcional: Configuración de autenticación OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# NEXTAUTH_SECRET=your_nextauth_secret
# NEXTAUTH_URL=http://localhost:3000
